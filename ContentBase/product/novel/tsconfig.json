{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": "../..",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "app/article/config.ts",
    "app/article/gateway-client.ts",
    "app/article/reranker.ts",
    "app/article/model-runtime.ts",
    "app/article/post-process.ts",
    "app/article/context-engine.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
