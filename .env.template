# ContentMRS — Unified Environment Configuration
# Copy this file to .env and fill in your values.
# All services read from this single source of truth.

# ═══════════════════════════════════════════════════════
# INFRASTRUCTURE
# ═══════════════════════════════════════════════════════

# Deploy target server
SERVER_HOST=124.220.233.126
SERVER_USER=ubuntu

# MySQL (data storage)
MYSQL_HOST=124.220.245.121
MYSQL_PORT=22295
MYSQL_DATABASE=cloudbase-4glvyyq9f61b19cd
MYSQL_USER=
MYSQL_PASSWORD=

# MySQL read-write user (for gateway write operations)
MYSQL_RW_USER=
MYSQL_RW_PASSWORD=

# ═══════════════════════════════════════════════════════
# AI MODELS
# ═══════════════════════════════════════════════════════

# Writer LLM (default Writer for essay/historical-essay/reality_commentary)
# OpenAI-compatible endpoint. ContentBase reads CONTENTBASE_LLM_* directly.
CONTENTBASE_LLM_BASE_URL=https://openoneapi.com/v1
CONTENTBASE_LLM_API_KEY=
CONTENTBASE_LLM_MODEL=claude-sonnet-4-6

# Qwen Writer (used for narrative/fiction genres via DashScope-compatible endpoint)
# When narrative/fiction genre is detected and CONTENTBASE_QWEN_BASE_URL is set,
# generation routes to Qwen instead of the default LLM.
CONTENTBASE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTENTBASE_QWEN_API_KEY=
CONTENTBASE_QWEN_MODEL=qwen-max

# ContentBase API key (set to enable bearer auth on /api/* endpoints; empty = no auth)
CONTENTBASE_API_KEY=

# Embedding & Rerank (retrieval reranker) — DashScope / Tongyi-Qianwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Research LLM (gateway-internal query expansion; falls back to CONTENTBASE_LLM_* when empty)
DATABASE_RESEARCH_LLM_BASE_URL=
DATABASE_RESEARCH_LLM_API_KEY=
DATABASE_RESEARCH_LLM_MODEL=qwen-plus

# ═══════════════════════════════════════════════════════
# SEARCH & RETRIEVAL
# ═══════════════════════════════════════════════════════

# Tavily (web search for Reality channel)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=12

# RAGFlow (vector search)
RAGFLOW_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=

# RAGFlow dataset IDs (create these in RAGFlow UI first)
RAGFLOW_DATASET_LITERARY=          # Literary corpus (books/literature)
RAGFLOW_DATASET_ESSAY=             # Essay evidence
RAGFLOW_DATASET_FILM=              # Film evidence
RAGFLOW_DATASET_XINGWANG=          # Historical evidence

# ═══════════════════════════════════════════════════════
# SERVICE PORTS (internal, all bind 127.0.0.1)
# ═══════════════════════════════════════════════════════

# DataBase Gateway: same port locally and in production
GATEWAY_PORT=18090

# ContentBase: local default 5101, production 5111
# CLI --port flag overrides this; ops/contentbase.service pins 5111
CONTENTBASE_PORT=5111

# Web Evidence Provider
WEB_EVIDENCE_PORT=19091

# ═══════════════════════════════════════════════════════
# RAGFLOW EVIDENCE TUNING
# ═══════════════════════════════════════════════════════

# Vector similarity weight for RAGFlow retrieval (0.0-1.0).
# Code default and canonical value: 0.35
DATABASE_EVIDENCE_RAGFLOW_VECTOR_WEIGHT=0.35
DATABASE_EVIDENCE_RAGFLOW_SIMILARITY_THRESHOLD=0.2
DATABASE_EVIDENCE_RAGFLOW_TOP_K=1024

# ═══════════════════════════════════════════════════════
# GATEWAY AUTH
# ═══════════════════════════════════════════════════════

# API key that ContentBase uses to call Gateway
DATABASE_GATEWAY_API_KEY=
# Header name for the API key
DATABASE_GATEWAY_HEADER=X-DataBase-Api-Key
