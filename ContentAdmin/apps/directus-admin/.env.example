DIRECTUS_VERSION=11
DIRECTUS_PORT=8055

KEY=replace-with-local-dev-key
SECRET=replace-with-local-dev-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db

PUBLIC_URL=http://127.0.0.1:8055

# Directus 运行在 Docker 容器内，访问宿主机 Gateway 要使用 host.docker.internal。
DATABASE_GATEWAY_URL=http://host.docker.internal:18207
DATABASE_GATEWAY_API_KEY=
CONTENTBASE_RUNTIME_URL=http://127.0.0.1:5101
CONTENTBASE_RUNTIME_API_KEY=
