# Optional EvidenceProvider backends. DataBase owns the provider boundary;
# consumers only request /evidence/search and never read these providers directly.
# Tavily-backed provider: DataBase/apps/web-evidence-provider (default http://127.0.0.1:19091/search)
DATABASE_EVIDENCE_WEB_SEARCH_URL=http://127.0.0.1:19091/search
DATABASE_EVIDENCE_RAGFLOW_URL=
DATABASE_EVIDENCE_RAGFLOW_API_KEY=
DATABASE_EVIDENCE_RAGFLOW_DATASET_IDS=
DATABASE_EVIDENCE_RAGFLOW_DATASET_WEB=
DATABASE_EVIDENCE_RAGFLOW_DATASET_HYBRID=
DATABASE_EVIDENCE_RAGFLOW_DOCUMENT_IDS=
DATABASE_EVIDENCE_RAGFLOW_REQUIRED=true
# prepare:ragflow-evidence requires an embedding model that RAGFlow can really call.
# Do not set Builtin here unless TEI is deliberately enabled in RAGFlow.
DATABASE_EVIDENCE_RAGFLOW_EMBEDDING_MODEL=
DATABASE_EVIDENCE_RAGFLOW_SIMILARITY_THRESHOLD=0.2
DATABASE_EVIDENCE_RAGFLOW_VECTOR_WEIGHT=0.35
# EvidencePack rank fusion (defaults to RAGFLOW_VECTOR_WEIGHT when unset)
DATABASE_EVIDENCE_VECTOR_FUSION_WEIGHT=0.35
DATABASE_EVIDENCE_LATENT_RERANK_URL=
DATABASE_EVIDENCE_LATENT_RERANK_TIMEOUT_MS=5000
DATABASE_EVIDENCE_LATENT_RERANK_TOP_K=32
DATABASE_EVIDENCE_RAGFLOW_TOP_K=1024
DATABASE_EVIDENCE_RAGFLOW_USE_KG=false
DATABASE_EVIDENCE_RAGFLOW_TOC_ENHANCE=false

# Material boundary: reject unscoped /evidence/search and /scope/resolve without notebookId|sourceIds|ragflow.
# Local dev override: DATABASE_EVIDENCE_ALLOW_UNSCOPED=true
DATABASE_EVIDENCE_REQUIRE_SCOPE=true

# Required for all data endpoints except GET / and GET /health.
DATABASE_GATEWAY_AUTH_REQUIRED=false
DATABASE_GATEWAY_API_KEY=replace-with-generated-key
